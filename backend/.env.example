# Copia este archivo como ".env" y cambia el valor de JWT_SECRET.
# Genera uno seguro con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=cambia-este-valor-por-uno-aleatorio-de-64-caracteres
JWT_EXPIRE_MINUTES=60

# Usuario de prueba que se crea automaticamente al iniciar el servidor
DEMO_USER_NAME=Administrador
DEMO_USER_EMAIL=admin@inventario.com
DEMO_USER_PASSWORD=Admin123*
